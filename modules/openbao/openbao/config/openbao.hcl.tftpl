ui            = false
disable_mlock = true

api_addr     = "${api_address}"
cluster_addr = "${cluster_address}"

storage "raft" {
  path    = "/openbao/data"
  node_id = "openbao"
}

seal "static" {
  current_key_id = "${seal_key_id}"
  current_key    = "file:///openbao/seal/static-seal.key"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "/openbao/config/tls.crt"
  tls_key_file    = "/openbao/config/tls.key"
}

initialize "admin" {
  request "admin-policy" {
    operation = "update"
    path      = "sys/policies/acl/admin"
    data = {
      policy = <<-HCL
        path "*" {
          capabilities = ["create", "read", "update", "delete", "list", "patch", "sudo"]
        }
      HCL
    }
  }

  request "admin-auth" {
    operation = "update"
    path      = "sys/auth/admin"
    data = {
      type = "userpass"
    }
  }

  request "admin-user" {
    operation = "update"
    path      = "auth/admin/users/admin"
    data = {
      password = {
        eval_source = "file"
        eval_type   = "string"
        path        = "/openbao/seal/admin-password"
      }
      token_policies = ["admin"]
      token_ttl      = "1h"
      token_max_ttl  = "24h"
    }
  }
}
