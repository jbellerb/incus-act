#!/usr/bin/python3
"""Serve OpenBao values as systemd socket credentials."""

import json
import os
import socket
import ssl
import sys
import time
from pathlib import Path
from urllib.error import HTTPError
from urllib.request import Request, urlopen

import tomllib

CONFIG_DIRECTORY = Path("/etc/openbao/credential-broker.d")


def load_config():
    files = sorted(CONFIG_DIRECTORY.glob("*.toml"))
    if not files:
        raise ValueError("broker config directory contains no TOML files")
    entries = []
    for filename in files:
        with filename.open("rb") as source:
            config = tomllib.load(source)
        if set(config) != {"credentials"}:
            raise ValueError(f"{filename}: broker config must contain only credentials")
        entries.extend(config["credentials"])
    credentials = {}
    for entry in entries:
        if ("unit" in entry) == ("units" in entry):
            raise ValueError("credential mapping must specify unit or units")
        source_keys = set(entry) - {"unit", "units"}
        if source_keys == {"id", "kv_path", "kv_field"}:
            kind = "kv"
            value = entry["kv_path"], entry["kv_field"]
        elif source_keys == {"id", "approle_role"}:
            kind = "approle"
            value = entry["approle_role"]
        else:
            raise ValueError(f"invalid credential mapping {entry}")
        units = entry["units"] if "units" in entry else [entry["unit"]]
        if not isinstance(units, list) or not units:
            raise ValueError("credential units must be a non-empty list")
        if isinstance(value, tuple):
            valid = all(isinstance(part, str) and part for part in value)
        else:
            valid = isinstance(value, str) and bool(value)
        if not valid:
            raise ValueError("invalid credential source")
        for unit in units:
            identity = unit, entry["id"]
            if not all(isinstance(part, str) and part for part in identity):
                raise ValueError("credential unit and id must be non-empty strings")
            if identity in credentials:
                raise ValueError(f"duplicate credential {identity}")
            credentials[identity] = kind, value
    return credentials


def log(message):
    print(message, file=sys.stderr, flush=True)


def error_description(exc):
    if isinstance(exc, HTTPError):
        return f"HTTP {exc.code}"
    return type(exc).__name__


def request(address, path, context, token=None, body=None):
    headers = {"Content-Type": "application/json"}
    if token is not None:
        headers["X-Vault-Token"] = token
    data = json.dumps(body).encode() if body is not None else None
    method = "POST" if data is not None else "GET"
    req = Request(f"{address}/v1/{path}", data=data, headers=headers, method=method)
    with urlopen(req, context=context, timeout=10) as response:
        return json.load(response)


def login(address, context, auth):
    result = request(
        address, f"auth/{os.environ['SCHEDULER_APPROLE_BACKEND']}/login", context, body=auth
    )
    return result["auth"]["client_token"]


def requester(conn):
    peer = conn.getpeername()
    if not isinstance(peer, bytes) or not peer.startswith(b"\0"):
        return None
    try:
        random, identity = peer[1:].split(b"/unit/", 1)
        unit, credential = identity.rsplit(b"/", 1)
        if not random or b"/" in random:
            return None
        return unit.decode("ascii"), credential.decode("ascii")
    except (ValueError, UnicodeError):
        return None


def notify_ready():
    address = os.environ.get("NOTIFY_SOCKET")
    if address:
        if address.startswith("@"):
            address = "\0" + address[1:]
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
            channel.connect(address)
            channel.sendall(b"READY=1")


def main():
    credentials = load_config()
    address = os.environ["VAULT_ADDR"]
    context = ssl.create_default_context(cafile=os.environ["VAULT_CACERT"])
    with open(
        f"{os.environ['CREDENTIALS_DIRECTORY']}/{os.environ['BROKER_AUTH_FILE']}",
        encoding="utf-8",
    ) as source:
        auth = json.load(source)
    if set(auth) != {"role_id", "secret_id"}:
        raise ValueError("broker-auth must contain role_id and secret_id")

    while True:
        try:
            token = login(address, context, auth)
            break
        except (OSError, KeyError, ValueError) as exc:
            log(f"OpenBao login unavailable ({error_description(exc)}). Retrying...")
            time.sleep(5)

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
        listener.bind(os.environ["BROKER_SOCKET"])
        os.chmod(os.environ["BROKER_SOCKET"], 0o600)
        listener.listen(16)
        notify_ready()

        while True:
            with listener.accept()[0] as conn:
                conn.settimeout(10)
                identity = requester(conn)
                if not identity or identity not in credentials:
                    log("Denied unlisted credential request")
                    continue
                try:
                    kind, source = credentials[identity]
                    if kind == "approle":
                        path = f"auth/{os.environ['TASK_APPROLE_BACKEND']}/role/{source}/secret-id"
                        field = "secret_id"
                        body = {}
                    else:
                        path, field = source
                        body = None

                    try:
                        result = request(address, path, context, token=token, body=body)
                    except HTTPError as exc:
                        if exc.code != 403:
                            raise
                        token = login(address, context, auth)
                        result = request(address, path, context, token=token, body=body)
                    value = (
                        result["data"][field]
                        if kind == "approle"
                        else result["data"]["data"][field]
                    )
                    if not isinstance(value, str):
                        raise TypeError("secret field is not a string")
                    conn.sendall(value.encode())
                except (OSError, KeyError, ValueError, TypeError) as exc:
                    log(
                        f"Credential request failed for {identity[0]}/{identity[1]} ({error_description(exc)})"
                    )


if __name__ == "__main__":
    main()
