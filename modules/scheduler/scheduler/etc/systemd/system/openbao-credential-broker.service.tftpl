[Unit]
Description=OpenBao systemd credential broker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
Environment=VAULT_ADDR=${openbao_address}
Environment=VAULT_CACERT=/etc/openbao/tls.crt
Environment=SCHEDULER_APPROLE_BACKEND=${scheduler_approle_backend}
Environment=TASK_APPROLE_BACKEND=${task_approle_backend}
Environment=BROKER_SOCKET=/run/openbao-credential-broker/socket
Environment=BROKER_AUTH_FILE=broker-auth
ExecStart=/usr/local/libexec/openbao-credential-broker
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=5s
RuntimeDirectory=openbao-credential-broker
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
